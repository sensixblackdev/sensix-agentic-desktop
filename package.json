{
  "name": "sensix-agentic-desktop",
  "version": "0.3.26",
  "description": "SENSIX Agentic Desktop — AUTO Primary Model & Anti-Refusal Architecture with Strict Native Tool Calling (100% OpenAI Function Calling Compliant)",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:renderer": "vite build --config renderer/vite.config.mjs",
    "build": "npm run build:renderer",
    "dev:renderer": "vite --config renderer/vite.config.mjs",
    "check": "node --check main.cjs && node --check preload.cjs && node --check telemetry.cjs && node --check directives-rag.cjs && node --check learning-ledger.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.axion.sensix.agentic",
    "productName": "SENSIX Agentic Desktop",
    "files": [
      "main.cjs",
      "preload.cjs",
      "telemetry.cjs",
      "directives-rag.cjs",
      "learning-ledger.cjs",
      "renderer/**/*",
      "README.md"
    ],
    "directories": {
      "output": "E:/axion/dists/sensix-agentic-desktop"
    },
    "artifactName": "SENSIX.Agentic.Desktop.Setup.${version}.${ext}",
    "win": {
      "target": "nsis"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller"
    ]
  }
}