{
  "name": "sensix-agentic-desktop",
  "version": "0.3.31",
  "description": "SENSIX Agentic Desktop — secure Electron runtime, isolated multi-session streaming, persistent projects and verified agent controls",
  "author": "AXION Enterprise <axionenterprise777@gmail.com>",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:renderer": "vite build --config renderer/vite.config.mjs",
    "build": "npm run build:renderer",
    "dev:renderer": "vite --config renderer/vite.config.mjs",
    "check": "node --check main.cjs && node --check preload.cjs && node --check telemetry.cjs && node --check directives-rag.cjs && node --check learning-ledger.cjs && node --check runtime-core.cjs && node --check terminal-service.cjs",
    "test": "node --test tests/*.test.cjs && node --experimental-test-coverage --test-coverage-include=runtime-core.cjs --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 --test tests/runtime-core.test.cjs",
    "test:e2e": "playwright test tests/electron-smoke.spec.cjs --workers=1"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "node-pty": "1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.axion.sensix.agentic",
    "productName": "SENSIX Agentic Desktop",
    "files": [
      "main.cjs",
      "preload.cjs",
      "telemetry.cjs",
      "directives-rag.cjs",
      "learning-ledger.cjs",
      "runtime-core.cjs",
      "terminal-service.cjs",
      "renderer/**/*",
      "README.md"
    ],
    "directories": {
      "output": "E:/axion/dists/sensix-agentic-desktop"
    },
    "artifactName": "SENSIX.Agentic.Desktop.Setup.${version}.${ext}",
    "win": {
      "target": "nsis"
    }
  }
}
